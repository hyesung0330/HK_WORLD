generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ===================================
// User: 작가와 독자 (본질을 기록하는 사람)
// ===================================
model User {
  id            Int       @id @default(autoincrement())
  name          String?
  email         String?   @unique
  emailVerified DateTime? @map("email_verified")
  image         String?
  password      String? // 소셜 로그인 사용자를 위해 Optional로 변경
  bio           String?   @db.VarChar(200) // 짧은 작가 소개
  githubUrl     String?   @map("github_url")

  // 등급 체계 (필력이나 영향력)
  reputation Int      @default(0)
  level      Int      @default(1)
  xp         Int      @default(0)
  points     Int      @default(0) // 작가 포인트 (정산 가능)
  role       UserRole @default(JUNIOR)

  consecutiveDays Int      @default(0) @map("consecutive_days")
  lastAttendanceDate DateTime? @map("last_attendance_date")

  coderaUsageCount Int      @default(0) @map("codera_usage_count")
  
  lograSubscription LograSubscription @default(NONE) @map("logra_subscription")
  lograUsageCount   Int               @default(0)    @map("logra_usage_count")
  lograNextReset    DateTime?         @map("logra_next_reset")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  accounts       Account[] // 소셜 계정 연동 정보
  sessions       Session[]
  posts          Post[]
  series         Series[] // 시리즈 소유 권한
  comments       Comment[]
  likes          Like[]
  scraps         Scrap[] // 저장된 글
  followers      Follow[]          @relation("following")
  following      Follow[]          @relation("follower")
  awardsReceived BestEditorAward[] @relation("receiver")
  awardsGiven    BestEditorAward[] @relation("giver")
  postViews      PostView[]
  settlementRequests SettlementRequest[]
  attendances    Attendance[]
  gameLogs       GameLog[]
  notifications  Notification[] @relation("user_notifications")
  sentNotifications Notification[] @relation("sender_notifications")
  commentLikes   CommentLike[]

  @@map("users")
}

enum UserRole {
  JUNIOR
  SENIOR
  PRO
  PROFESSIONAL
}

enum LograSubscription {
  NONE
  FREE
  STANDARD
  PRO
}

enum SettlementStatus {
  PENDING
  COMPLETED
  REJECTED
}

model SettlementRequest {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  amount    Int
  status    SettlementStatus @default(PENDING)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("settlement_requests")
}

model Follow {
  followerId  Int
  followingId Int
  follower    User @relation("follower", fields: [followerId], references: [id], onDelete: Cascade)
  following   User @relation("following", fields: [followingId], references: [id], onDelete: Cascade)

  @@id([followerId, followingId])
  @@map("follows")
}

model BestEditorAward {
  id         Int            @id @default(autoincrement())
  type       BestEditorType
  postId     Int            @unique // Only one person can award per post
  post       Post           @relation(fields: [postId], references: [id], onDelete: Cascade)
  giverId    Int
  giver      User           @relation("giver", fields: [giverId], references: [id], onDelete: Cascade)
  receiverId Int
  receiver   User           @relation("receiver", fields: [receiverId], references: [id], onDelete: Cascade)
  createdAt  DateTime       @default(now())

  @@map("best_editor_awards")
}

enum BestEditorType {
  GOLD
  SILVER
  BRONZE
}

// ===================================
// Account: 소셜 로그인 연동 정보 (OAuth)
// ===================================
model Account {
  id                Int     @id @default(autoincrement())
  userId            Int     @map("user_id")
  type              String // OAuth 타입 (예: "oauth")
  provider          String // 서비스 제공자 (예: "google", "github", "kakao")
  providerAccountId String  @map("provider_account_id") // 제공자 측의 유저 고유 ID
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

model Session {
  id           Int      @id @default(autoincrement())
  sessionToken String   @unique @map("session_token")
  userId       Int      @map("user_id")
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ===================================
// Series: 글의 묶음 (근본 있는 연재물)
// ===================================
model Series {
  id          Int     @id @default(autoincrement())
  title       String
  description String? @db.Text
  slug        String  @unique // URL용 고유 주소

  authorId Int  @map("author_id")
  author   User @relation(fields: [authorId], references: [id], onDelete: Cascade)

  posts     Post[]
  createdAt DateTime @default(now()) @map("created_at")

  @@map("series")
}

// ===================================
// Post: 텍스트 본문 (플랫폼의 핵심)
// ===================================
enum PostType {
  PIECE // 단편/에세이
  COLUMN // 전문 칼럼
  TECHNICAL // 기술/정보
}

model Post {
  id       Int      @id @default(autoincrement())
  title    String
  content  String   @db.Text
  summary  String?  @db.VarChar(500) // 글 요약
  postType PostType @default(PIECE) @map("post_type")
  views    Int      @default(0)
  readTime Int?     @map("read_time") // 예상 읽기 시간 (분)
  coverImage  String?  @map("cover_image")
  link        String?
  techStack   String?  @map("tech_stack")

  // Author & Series
  authorId Int  @map("author_id")
  author   User @relation(fields: [authorId], references: [id], onDelete: Cascade)

  seriesId    Int?    @map("series_id")
  series      Series? @relation(fields: [seriesId], references: [id], onDelete: SetNull)
  seriesOrder Int?    @map("series_order") // 시리즈 내 순서

  // Metadata
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  tags            PostTag[]
  comments        Comment[]
  likes           Like[]
  scraps          Scrap[]
  bestEditorAward BestEditorAward?
  postViews       PostView[]
  notifications   Notification[]

  @@index([authorId])
  @@index([seriesId])
  @@map("posts")
}

// ===================================
// Tag: 텍스트 분류 (N:M 관계)
// ===================================
model Tag {
  id    Int       @id @default(autoincrement())
  name  String    @unique
  posts PostTag[]

  @@map("tags")
}

model PostTag {
  postId Int  @map("post_id")
  tagId  Int  @map("tag_id")
  post   Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  tag    Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([postId, tagId])
  @@map("post_tags")
}

// ===================================
// Comment: 문장에 대한 반응
// ===================================
model Comment {
  id        Int      @id @default(autoincrement())
  content   String   @db.Text
  createdAt DateTime @default(now()) @map("created_at")

  authorId  Int?    @map("author_id")
  author    User?   @relation(fields: [authorId], references: [id], onDelete: Cascade)
  
  // 익명 댓글용 필드
  isAnonymous Boolean @default(false) @map("is_anonymous")
  nickname    String? // 익명일 때 사용되는 닉네임

  postId Int  @map("post_id")
  post   Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  parentId Int?      @map("parent_id")
  parent   Comment?  @relation("Replies", fields: [parentId], references: [id], onDelete: Cascade)
  replies  Comment[] @relation("Replies")

  likes    CommentLike[]

  @@map("comments")
}

// ===================================
// Interaction: 좋아요 & 스크랩
// ===================================
model Like {
  id     Int  @id @default(autoincrement())
  userId Int? @map("user_id")
  postId Int  @map("post_id")
  
  // 익명 좋아요용 (쿠키/세션 ID 기반 등)
  anonymousId String? @map("anonymous_id")

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)
  post Post  @relation(fields: [postId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([userId, postId])
  @@unique([anonymousId, postId])
  @@map("likes")
}

model CommentLike {
  id        Int      @id @default(autoincrement())
  userId    Int?     @map("user_id")
  commentId Int      @map("comment_id")
  
  // 익명 좋아요용
  anonymousId String? @map("anonymous_id")

  user    User?   @relation(fields: [userId], references: [id], onDelete: Cascade)
  comment Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([userId, commentId])
  @@unique([anonymousId, commentId])
  @@map("comment_likes")
}

model Scrap {
  userId    Int      @map("user_id")
  postId    Int      @map("post_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at")

  @@id([userId, postId])
  @@map("scraps")
}

// ===================================
// PostView: 조회수 추적 및 경험치 지급 제한
// ===================================
model PostView {
  id        Int      @id @default(autoincrement())
  postId    Int      @map("post_id")
  userId    Int?     @map("user_id") // 로그인 유저
  sessionId String?  @map("session_id") // 비로그인 유저 (세션/쿠키 기반)
  count     Int      @default(1)
  updatedAt DateTime @updatedAt @map("updated_at")

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@unique([postId, sessionId])
  @@map("post_views")
}

model Attendance {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  date      DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("attendances")
}

enum NotificationType {
  FOLLOW
  LIKE
  COMMENT
  AWARD
  SYSTEM
}

model Notification {
  id        Int              @id @default(autoincrement())
  userId    Int              @map("user_id") // 수신자
  type      NotificationType
  senderId  Int?             @map("sender_id") // 발신자 (시스템 알림일 경우 null 가능)
  postId    Int?             @map("post_id") // 관련 게시글 ID (타입에 따라 선택적)
  isRead    Boolean          @default(false) @map("is_read")
  createdAt DateTime         @default(now()) @map("created_at")

  user   User  @relation("user_notifications", fields: [userId], references: [id], onDelete: Cascade)
  sender User? @relation("sender_notifications", fields: [senderId], references: [id], onDelete: Cascade)
  post   Post? @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("notifications")
}

model GameLog {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  score     Int
  xp        Int
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("game_logs")
}
